# Generate with: openssl rand -hex 32
LOGSCAN_API_KEY=replace-with-a-long-random-value

# Required for People identity resolution, images, and trending candidates.
TMDB_API_KEY=

# Optional: notify Discord when a log adds a new missing person.
DISCORD_PEOPLE_WEBHOOK_URL=

# Keep shared People queue mutations disabled until an authorization model is chosen.
PEOPLE_ACTIONS_ENABLED=false

# Local default. Containers override this with /data/scans.
SCAN_STORE=./data/scans
