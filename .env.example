# Generate with: openssl rand -hex 32
LOGSCAN_API_KEY=replace-with-a-long-random-value


# Discord OAuth protects the support log inventory.
# Add this exact redirect in the Discord Developer Portal.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://logscan.kometa.team/support/callback
DISCORD_GUILD_ID=
# Comma-separated Discord role IDs; membership in any listed role grants access.
DISCORD_SUPPORT_ROLE_IDS=
# Generate independently with: openssl rand -hex 32
LOGSCAN_SECRET_KEY=
LOGSCAN_SECURE_COOKIES=true
# Required for People identity resolution, images, and trending candidates.
TMDB_API_KEY=

# Optional: notify Discord when a log adds a new missing person.
DISCORD_PEOPLE_WEBHOOK_URL=

# Keep shared People queue mutations disabled until an authorization model is chosen.
PEOPLE_ACTIONS_ENABLED=false

# Local default. Containers override this with /data/scans.
SCAN_STORE=./data/scans
